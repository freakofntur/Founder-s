{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "foundry-results@foundry.browser"
    }
  },
  "name": "Foundry Results",
  "version": "1.6",
  "content_scripts": [
    {
      "matches": ["https://www.google.com/search*"],
      "js": ["aimode.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ]
}
