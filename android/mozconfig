# Foundry for Android: frontend-only ("artifact") build.
# Gecko's compiled parts are downloaded prebuilt from Mozilla's CI instead of compiled,
# so a build takes minutes instead of hours. Our changes are all in Kotlin/Java/resources.
ac_add_options --enable-project=mobile/android
ac_add_options --target=aarch64-linux-android
ac_add_options --enable-artifact-builds
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/objdir-foundry
