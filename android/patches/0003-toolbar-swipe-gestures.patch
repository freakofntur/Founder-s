+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.components.toolbar.gestures
+
+import kotlin.math.PI
+import kotlin.math.abs
+import kotlin.math.max
+import kotlin.math.sin
+
+/**
+ * The line a toolbar swipe has to cross to do anything, shaped like a pair of eyebrows over the starting point.
+ * Released under it, the swipe does nothing; released past it, it goes back/forward, to the neighbouring tab or to
+ * the tabs tray. [FoundryBrowsGuide] draws the brows with their top edge on this line, so what is shown is the limit.
+ *
+ * Each brow starts low beside the starting point ([HEAD_DP] up), arches up to [PEAK_DP] and falls to a tail
+ * [SIDE_REACH_DP] to the side; past the tail, moving that far sideways crosses the limit at any height.
+ */
+class FoundrySwipeLimit(private val density: Float) {
+    /** How far sideways a brow reaches, in pixels. */
+    val sideReach = SIDE_REACH_DP * density
+
+    /** Where a brow begins, sideways from the starting point, in pixels. */
+    val browStart = BROW_GAP_DP * density
+
+    /** Height of the brow's top edge above the starting point, [x] pixels to either side. */
+    fun heightAt(x: Float): Float {
+        val dp = (abs(x) / density).coerceAtMost(SIDE_REACH_DP)
+        val height =
+            if (dp <= PEAK_AT_DP) {
+                HEAD_DP + (PEAK_DP - HEAD_DP) * sin(PI / 2 * dp / PEAK_AT_DP).toFloat()
+            } else {
+                val u = (dp - PEAK_AT_DP) / (SIDE_REACH_DP - PEAK_AT_DP)
+                PEAK_DP - (PEAK_DP - TAIL_DP) * u * u
+            }
+        return height * density
+    }
+
+    /**
+     * How far a point is towards the limit: below 1 is under the brows, 1 or more has crossed.
+     *
+     * @param dx Sideways distance from the starting point, in pixels.
+     * @param away Distance away from the toolbar's screen edge, in pixels.
+     */
+    fun reach(dx: Float, away: Float): Float {
+        val sideways = abs(dx) / sideReach
+        val up = if (away > 0f) away / heightAt(dx) else 0f
+        return max(sideways, up)
+    }
+
+    fun isCrossed(dx: Float, away: Float) = reach(dx, away) >= 1f
+
+    /** Whether a point past the limit went out to one side (rather than up over the middle). */
+    fun isToTheSide(dx: Float) = abs(dx) >= SIDE_SPLIT_DP * density
+
+    private companion object {
+        const val SIDE_REACH_DP = 172f
+        const val HEAD_DP = 92f
+        const val PEAK_DP = 122f
+        const val PEAK_AT_DP = 118f
+        const val TAIL_DP = 64f
+        const val BROW_GAP_DP = 10f
+        const val SIDE_SPLIT_DP = 64f
+    }
+}
