+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.components.toolbar.gestures
+
+import android.animation.ValueAnimator
+import android.graphics.Bitmap
+import android.graphics.Color
+import android.graphics.Outline
+import android.text.TextUtils
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.view.ViewOutlineProvider
+import android.widget.FrameLayout
+import android.widget.ImageView
+import android.widget.TextView
+import androidx.core.animation.doOnEnd
+import androidx.interpolator.view.animation.FastOutSlowInInterpolator
+import kotlin.math.abs
+import kotlin.math.roundToInt
+import mozilla.components.browser.state.selector.getNormalOrPrivateTabs
+import mozilla.components.browser.state.selector.selectedTab
+import mozilla.components.browser.state.state.TabSessionState
+import mozilla.components.browser.state.store.BrowserStore
+import mozilla.components.browser.thumbnails.loader.ThumbnailLoader
+import mozilla.components.concept.base.images.ImageLoadRequest
+import org.mozilla.fenix.ext.components
+
+/**
+ * The card-based tab switcher driven by the toolbar's upward swipe, in the style of Android's recent apps.
+ *
+ * While the finger is down the current page shrinks into a card that follows it, with the neighbouring tabs beside
+ * it; moving sideways slides through them. On release the centred card opens full screen, or, if it is still the
+ * current tab, the full tabs tray opens.
+ *
+ * @param container The view the overlay is drawn over, normally the fragment's [SwipeGestureLayout].
+ * @param captureCurrent Delivers a snapshot of the current page, used for the current tab's card.
+ * @param onSelectTab Switches to the chosen tab.
+ * @param onShowTabsTray Opens the full tabs tray.
+ * @param toolbarAtBottom Whether the gesture comes from the bottom of the screen (true) or the top.
+ */
+@Suppress("TooManyFunctions")
+class FoundryTabSwitcher(
+    private val container: ViewGroup,
+    private val store: BrowserStore,
+    private val captureCurrent: ((Bitmap?) -> Unit) -> Unit,
+    private val onSelectTab: (TabSessionState) -> Unit,
+    private val onShowTabsTray: () -> Unit,
+    private val toolbarAtBottom: Boolean,
+) {
+    private class Card(val index: Int, val tab: TabSessionState, val root: FrameLayout, val title: TextView)
+
+    private val context = container.context
+    private val density = context.resources.displayMetrics.density
+    private val thumbnailLoader = ThumbnailLoader(context.components.core.thumbnailStorage)
+
+    private var overlay: FrameLayout? = null
+    private var cards = emptyList<Card>()
+    private var tabs = emptyList<TabSessionState>()
+    private var currentIndex = 0
+    private var animator: ValueAnimator? = null
+
+    /** Distance the finger has moved away from the toolbar edge. */
+    private var travel = 0f
+
+    /** Fractional index of the tab in the middle of the screen. */
+    private var position = 0f
+
+    val isActive: Boolean
+        get() = overlay != null
+
+    fun start() {
+        cancelAnimation()
+        removeOverlay()
+        val current = store.state.selectedTab ?: return
+        tabs = store.state.getNormalOrPrivateTabs(current.content.private)
+        currentIndex = tabs.indexOfFirst { it.id == current.id }.coerceAtLeast(0)
+        position = currentIndex.toFloat()
+        travel = 0f
+
+        val root = FrameLayout(context).apply { setBackgroundColor(Color.TRANSPARENT) }
+        container.addView(root, ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, MATCH))
+        overlay = root
+
+        val first = (currentIndex - WINDOW).coerceAtLeast(0)
+        val last = (currentIndex + WINDOW).coerceAtMost(tabs.lastIndex)
+        cards = (first..last).map { index -> buildCard(root, index, tabs[index]) }
+        render()
+    }
+
+    /**
+     * @param sideways Horizontal finger movement since the gesture started, in pixels.
+     * @param away Finger movement away from the toolbar edge, in pixels.
+     */
+    fun update(sideways: Float, away: Float) {
+        if (!isActive) return
+        travel = away.coerceAtLeast(0f)
+        position = (currentIndex - sideways / spacing()).coerceIn(firstCardIndex(), lastCardIndex())
+        render()
+    }
+
+    fun finish(velocityX: Float) {
+        if (!isActive) return
+        var target = position.roundToInt()
+        if (target == currentIndex && abs(velocityX) > FLING_VELOCITY * density) {
+            target = if (velocityX < 0) currentIndex + 1 else currentIndex - 1
+        }
+        target = target.coerceIn(firstCardIndex().toInt(), lastCardIndex().toInt())
+
+        when {
+            target != currentIndex -> animateTo(target.toFloat(), 0f) {
+                onSelectTab(tabs[target])
+                container.postDelayed({ fadeOutAndRemove() }, SETTLE_AFTER_SWITCH_MS)
+            }
+            progress() < CANCEL_PROGRESS -> animateTo(currentIndex.toFloat(), 0f) { removeOverlay() }
+            else -> {
+                onShowTabsTray()
+                fadeOutAndRemove()
+            }
+        }
+    }
+
+    fun cancel() {
+        if (!isActive) return
+        animateTo(currentIndex.toFloat(), 0f) { removeOverlay() }
+    }
+
+    private fun buildCard(parent: FrameLayout, index: Int, tab: TabSessionState): Card {
+        val radius = CARD_CORNER_DP * density
+        val card =
+            FrameLayout(context).apply {
+                setBackgroundColor(Color.WHITE)
+                clipToOutline = true
+                outlineProvider =
+                    object : ViewOutlineProvider() {
+                        override fun getOutline(view: View, outline: Outline) {
+                            // Corners are sized for the scaled card so they look the same at any size.
+                            val scaled = radius / view.scaleX.coerceAtLeast(MIN_SCALE)
+                            outline.setRoundRect(0, 0, view.width, view.height, scaled)
+                        }
+                    }
+                elevation = CARD_ELEVATION_DP * density
+            }
+        val image = ImageView(context).apply { scaleType = ImageView.ScaleType.CENTER_CROP }
+        card.addView(image, FrameLayout.LayoutParams(MATCH, MATCH))
+        parent.addView(card, FrameLayout.LayoutParams(container.widthOrScreen(), container.heightOrScreen()))
+
+        if (index == currentIndex) {
+            captureCurrent { bitmap -> bitmap?.let { image.setImageBitmap(it) } }
+        }
+        image.post {
+            if (index != currentIndex || image.drawable == null) {
+                thumbnailLoader.loadIntoView(
+                    image,
+                    ImageLoadRequest(tab.id, maxOf(image.width, image.height), tab.content.private),
+                )
+            }
+        }
+
+        val title =
+            TextView(context).apply {
+                text = tab.content.title.ifBlank { tab.content.url }
+                setTextColor(Color.WHITE)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, TITLE_TEXT_SP)
+                maxLines = 1
+                ellipsize = TextUtils.TruncateAt.END
+                gravity = Gravity.CENTER
+                alpha = 0f
+            }
+        parent.addView(title, FrameLayout.LayoutParams(container.widthOrScreen(), ViewGroup.LayoutParams.WRAP_CONTENT))
+        return Card(index, tab, card, title)
+    }
+
+    private fun render() {
+        val root = overlay ?: return
+        val p = progress()
+        val scale = 1f - (1f - MIN_SCALE) * p
+        val height = container.heightOrScreen().toFloat()
+        val spacing = spacing(scale)
+        // Keep the card's bottom (or top, for a top toolbar) edge under the finger.
+        val edgeOffset = height / 2 * (1 - scale)
+        val offsetY = if (toolbarAtBottom) edgeOffset - travel else travel - edgeOffset
+
+        root.setBackgroundColor(Color.argb((SCRIM_ALPHA * (p * SCRIM_RAMP).coerceAtMost(1f)).toInt(), 0, 0, 0))
+        for (card in cards) {
+            val x = (card.index - position) * spacing
+            card.root.apply {
+                pivotX = width / 2f
+                pivotY = height / 2f
+                scaleX = scale
+                scaleY = scale
+                translationX = x
+                translationY = offsetY
+                invalidateOutline()
+            }
+            card.title.apply {
+                translationX = x
+                translationY = card.root.top + height / 2 * (1 - scale) + offsetY - this.height - TITLE_GAP_DP * density
+                this.alpha = (p * 2f - 0.4f).coerceIn(0f, 1f)
+            }
+        }
+    }
+
+    private fun animateTo(targetPosition: Float, targetTravel: Float, onEnd: () -> Unit) {
+        cancelAnimation()
+        val startPosition = position
+        val startTravel = travel
+        animator =
+            ValueAnimator.ofFloat(0f, 1f).apply {
+                duration = SNAP_DURATION_MS
+                interpolator = FastOutSlowInInterpolator()
+                addUpdateListener {
+                    val f = it.animatedValue as Float
+                    position = startPosition + (targetPosition - startPosition) * f
+                    travel = startTravel + (targetTravel - startTravel) * f
+                    render()
+                }
+                doOnEnd { onEnd() }
+                start()
+            }
+    }
+
+    private fun fadeOutAndRemove() {
+        val root = overlay ?: return
+        root.animate().alpha(0f).setDuration(FADE_DURATION_MS).withEndAction { removeOverlay() }.start()
+    }
+
+    private fun removeOverlay() {
+        overlay?.let { container.removeView(it) }
+        overlay = null
+        cards = emptyList()
+    }
+
+    private fun cancelAnimation() {
+        animator?.cancel()
+        animator = null
+    }
+
+    private fun progress(): Float = (travel / (container.heightOrScreen() * FULL_SHRINK_FRACTION)).coerceIn(0f, 1f)
+
+    private fun spacing(scale: Float = 1f - (1f - MIN_SCALE) * progress()): Float =
+        container.widthOrScreen() * scale + CARD_GAP_DP * density
+
+    private fun firstCardIndex() = cards.firstOrNull()?.index?.toFloat() ?: currentIndex.toFloat()
+
+    private fun lastCardIndex() = cards.lastOrNull()?.index?.toFloat() ?: currentIndex.toFloat()
+
+    private fun View.widthOrScreen() = if (width > 0) width else resources.displayMetrics.widthPixels
+
+    private fun View.heightOrScreen() = if (height > 0) height else resources.displayMetrics.heightPixels
+
+    private companion object {
+        const val MATCH = ViewGroup.LayoutParams.MATCH_PARENT
+
+        /** Tabs shown on each side of the current one. */
+        const val WINDOW = 4
+
+        /** Smallest size of a card, as a fraction of the screen. */
+        const val MIN_SCALE = 0.55f
+
+        /** How far (as a fraction of the screen height) the finger travels to shrink the card fully. */
+        const val FULL_SHRINK_FRACTION = 0.35f
+
+        /** Below this much shrinking, releasing on the current tab just restores it. */
+        const val CANCEL_PROGRESS = 0.15f
+
+        const val CARD_GAP_DP = 16f
+        const val CARD_CORNER_DP = 20f
+        const val CARD_ELEVATION_DP = 8f
+        const val TITLE_GAP_DP = 8f
+        const val TITLE_TEXT_SP = 14f
+        const val SCRIM_ALPHA = 230f
+        const val SCRIM_RAMP = 3f
+        const val FLING_VELOCITY = 800f
+        const val SNAP_DURATION_MS = 260L
+        const val FADE_DURATION_MS = 150L
+        const val SETTLE_AFTER_SWITCH_MS = 120L
+    }
+}
