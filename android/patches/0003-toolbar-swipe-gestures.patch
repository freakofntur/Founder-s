@@ -0,0 +1,298 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.components.toolbar.gestures
+
+import android.animation.ValueAnimator
+import android.app.Activity
+import android.content.res.Configuration
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.LinearGradient
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.PointF
+import android.graphics.Shader
+import android.view.HapticFeedbackConstants
+import android.view.View
+import android.view.ViewGroup
+import androidx.core.animation.doOnEnd
+import androidx.core.graphics.ColorUtils
+import androidx.interpolator.view.animation.FastOutSlowInInterpolator
+import kotlin.math.PI
+import kotlin.math.abs
+import kotlin.math.sin
+
+/**
+ * Draws [FoundrySwipeLimit] from where a swipe starts, as a pair of shaded eyebrows: a darker brow whose top edge is
+ * the limit, over a lighter shade covering the area under it.
+ *
+ * Crossing the limit is shown differently for each gesture: going back/forward lights up the brow on that side;
+ * moving to a neighbouring tab raises the brow on that side; heading up to the tabs tray raises both.
+ *
+ * @param awayIsUp Whether "away from the toolbar" is up the screen (bottom toolbar) rather than down.
+ */
+class FoundryBrowsGuide(
+    private val activity: Activity,
+    private val limit: FoundrySwipeLimit,
+    private val awayIsUp: Boolean,
+) {
+    /** What the swipe has been recognised as, which decides how crossing the limit is shown. */
+    enum class Style { UNDECIDED, BACK_FORWARD, TABS }
+
+    private val density = activity.resources.displayMetrics.density
+    private val isNight =
+        activity.resources.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK == Configuration.UI_MODE_NIGHT_YES
+    private val shade = Color.parseColor(if (isNight) NIGHT_SHADE else DAY_SHADE)
+    private val brand = Color.parseColor(BRAND_COLOR)
+
+    private var view: BrowsView? = null
+    private var animator: ValueAnimator? = null
+    private var dismissing = false
+
+    /** @param start The raw screen position where the swipe started. */
+    fun show(start: PointF) {
+        remove()
+        val root = activity.window.decorView as? ViewGroup ?: return
+        val brows = BrowsView(start)
+        root.addView(brows, ViewGroup.LayoutParams(MATCH, MATCH))
+        view = brows
+        dismissing = false
+        animator =
+            ValueAnimator.ofFloat(0f, 1f).apply {
+                duration = APPEAR_MS
+                interpolator = FastOutSlowInInterpolator()
+                addUpdateListener {
+                    brows.drawn = it.animatedValue as Float
+                    brows.invalidate()
+                }
+                start()
+            }
+    }
+
+    /**
+     * @param dx Sideways finger movement since the start, in pixels.
+     * @param away Finger movement away from the toolbar's screen edge, in pixels.
+     * @param style What the swipe has been recognised as.
+     * @param canCross Whether crossing would do anything (false e.g. when there is no page to go back to).
+     */
+    fun update(dx: Float, away: Float, style: Style, canCross: Boolean) {
+        val brows = view ?: return
+        if (dismissing) return
+        val reach = limit.reach(dx, away)
+        val crossed = canCross && reach >= 1f
+        if (crossed != brows.crossed) {
+            brows.performHapticFeedback(HapticFeedbackConstants.CLOCK_TICK)
+            brows.crossed = crossed
+        }
+        // Index 0 is the brow on the right of the starting point, 1 the one on the left.
+        val side = if (dx >= 0f) 0 else 1
+        for (i in 0..1) {
+            brows.lightTarget[i] = if (crossed && style == Style.BACK_FORWARD && i == side) 1f else 0f
+            brows.raiseTarget[i] =
+                when {
+                    !crossed || style != Style.TABS -> 0f
+                    !limit.isToTheSide(dx) -> 1f
+                    i == side -> 1f
+                    else -> 0f
+                }
+        }
+        brows.nearness = reach.coerceIn(0f, 1f)
+        brows.fade =
+            if (style == Style.BACK_FORWARD && reach > 1f) {
+                (1f - (reach - 1f) / FADE_BEYOND).coerceIn(0f, 1f)
+            } else {
+                1f
+            }
+        brows.invalidate()
+    }
+
+    fun dismiss(quick: Boolean = false) {
+        val brows = view ?: return
+        if (dismissing) return
+        dismissing = true
+        animator?.cancel()
+        animator =
+            ValueAnimator.ofFloat(brows.fade, 0f).apply {
+                duration = if (quick) QUICK_DISMISS_MS else DISMISS_MS
+                addUpdateListener {
+                    brows.fade = it.animatedValue as Float
+                    brows.invalidate()
+                }
+                doOnEnd { if (view === brows) remove() }
+                start()
+            }
+    }
+
+    private fun remove() {
+        animator?.cancel()
+        animator = null
+        view?.let { (it.parent as? ViewGroup)?.removeView(it) }
+        view = null
+    }
+
+    private inner class BrowsView(private val start: PointF) : View(activity) {
+        var drawn = 0f
+        var fade = 1f
+        var nearness = 0f
+        var crossed = false
+        val lightTarget = FloatArray(2)
+        val raiseTarget = FloatArray(2)
+        private val light = FloatArray(2)
+        private val raise = FloatArray(2)
+
+        private val fill = Paint(Paint.ANTI_ALIAS_FLAG)
+        private val soft = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            style = Paint.Style.STROKE
+            strokeJoin = Paint.Join.ROUND
+        }
+        private val location = IntArray(2)
+        private val area = Path()
+        private val brow = Path()
+
+        init {
+            isClickable = false
+            isFocusable = false
+            importantForAccessibility = IMPORTANT_FOR_ACCESSIBILITY_NO
+        }
+
+        override fun onDraw(canvas: Canvas) {
+            if (fade <= 0f || drawn <= 0f) return
+            val settling = step(light, lightTarget) or step(raise, raiseTarget)
+            getLocationOnScreen(location)
+            val cx = start.x - location[0]
+            val cy = start.y - location[1]
+
+            canvas.save()
+            if (!awayIsUp) canvas.scale(1f, -1f, cx, cy)
+            drawArea(canvas, cx, cy)
+            for (i in 0..1) drawBrow(canvas, cx, cy, if (i == 0) 1 else -1, i)
+            canvas.restore()
+
+            if (settling) postInvalidateOnAnimation()
+        }
+
+        /** Moves each value part of the way to its target; returns whether any is still moving. */
+        private fun step(values: FloatArray, targets: FloatArray): Boolean {
+            var moving = false
+            for (i in values.indices) {
+                val delta = targets[i] - values[i]
+                if (abs(delta) < SETTLED) {
+                    values[i] = targets[i]
+                } else {
+                    values[i] += delta * EASE
+                    moving = true
+                }
+            }
+            return moving
+        }
+
+        private fun drawArea(canvas: Canvas, cx: Float, cy: Float) {
+            val reach = limit.sideReach
+            area.reset()
+            area.moveTo(cx - reach, cy)
+            for (i in 0..SAMPLES * 2) {
+                val x = -reach + 2 * reach * i / (SAMPLES * 2)
+                area.lineTo(cx + x, cy - limit.heightAt(x))
+            }
+            area.lineTo(cx + reach, cy)
+            area.close()
+            val alpha = fade * drawn * (AREA_ALPHA + AREA_NEAR_BOOST * nearness)
+            fill.shader =
+                LinearGradient(
+                    0f,
+                    cy - limit.heightAt(reach / 2),
+                    0f,
+                    cy,
+                    ColorUtils.setAlphaComponent(shade, (alpha * OPAQUE).toInt()),
+                    Color.TRANSPARENT,
+                    Shader.TileMode.CLAMP,
+                )
+            canvas.drawPath(area, fill)
+            fill.shader = null
+        }
+
+        /**
+         * One brow, from its head beside the starting point out to its tail. Its top edge lies on the limit, it is
+         * thickest at the head, and raising it lifts it and deepens its arch.
+         */
+        private fun drawBrow(canvas: Canvas, cx: Float, cy: Float, side: Int, index: Int) {
+            val from = limit.browStart
+            val to = from + (limit.sideReach - from) * drawn
+            val thickness = BROW_DP * density
+            val lift = RAISE_DP * density * raise[index]
+            brow.reset()
+            for (i in 0..SAMPLES) {
+                val x = from + (to - from) * i / SAMPLES
+                val u = (x - from) / (limit.sideReach - from)
+                val y = cy - limit.heightAt(x) - lift * arch(u)
+                if (i == 0) brow.moveTo(cx + side * x, y) else brow.lineTo(cx + side * x, y)
+            }
+            for (i in SAMPLES downTo 0) {
+                val x = from + (to - from) * i / SAMPLES
+                val u = (x - from) / (limit.sideReach - from)
+                val y = cy - limit.heightAt(x) - lift * arch(u) + thickness * taper(u)
+                brow.lineTo(cx + side * x, y)
+            }
+            brow.close()
+
+            val color = ColorUtils.blendARGB(shade, brand, light[index])
+            val strength = fade * (BROW_ALPHA + BROW_NEAR_BOOST * nearness + LIT_BOOST * light[index])
+            soft.color = color
+            for (layer in SHADOW) {
+                soft.strokeWidth = layer.widthDp * density
+                soft.alpha = (layer.alpha * strength * OPAQUE).toInt().coerceIn(0, OPAQUE)
+                canvas.drawPath(brow, soft)
+            }
+            fill.color = color
+            fill.alpha = (strength * OPAQUE).toInt().coerceIn(0, OPAQUE)
+            canvas.drawPath(brow, fill)
+        }
+
+        /** How much of the raise each point along the brow gets: some everywhere, most at the arch. */
+        private fun arch(u: Float) = RAISE_BASE + (1 - RAISE_BASE) * sin(PI * u).toFloat()
+
+        /** Brow thickness along its length: a rounded head, thick just after it, thinning to the tail. */
+        private fun taper(u: Float) = (1 - TAIL_THINNING * u) * (HEAD_ROUNDING + u * HEAD_RAMP).coerceAtMost(1f)
+    }
+
+    private class Layer(val widthDp: Float, val alpha: Float)
+
+    private companion object {
+        const val MATCH = ViewGroup.LayoutParams.MATCH_PARENT
+        const val OPAQUE = 255
+        const val BRAND_COLOR = "#2B50E0"
+        const val DAY_SHADE = "#1A1D26"
+        const val NIGHT_SHADE = "#D9DEEE"
+
+        const val SAMPLES = 36
+        const val BROW_DP = 16f
+        const val TAIL_THINNING = 0.75f
+        const val HEAD_ROUNDING = 0.45f
+        const val HEAD_RAMP = 6f
+
+        const val RAISE_DP = 14f
+        const val RAISE_BASE = 0.5f
+
+        const val BROW_ALPHA = 0.42f
+        const val BROW_NEAR_BOOST = 0.3f
+        const val LIT_BOOST = 0.25f
+        const val AREA_ALPHA = 0.12f
+        const val AREA_NEAR_BOOST = 0.06f
+
+        /** Soft edge around the brows, like a shadow: wide faint strokes. */
+        val SHADOW = listOf(Layer(14f, 0.08f), Layer(8f, 0.14f), Layer(3f, 0.3f))
+
+        /** How far past the limit, relative to it, the brows take to fade away while going back/forward. */
+        const val FADE_BEYOND = 0.5f
+
+        /** Per frame, how much of the remaining way a brow moves when lighting up or raising. */
+        const val EASE = 0.25f
+        const val SETTLED = 0.01f
+
+        const val APPEAR_MS = 220L
+        const val DISMISS_MS = 200L
+        const val QUICK_DISMISS_MS = 120L
+    }
+}
