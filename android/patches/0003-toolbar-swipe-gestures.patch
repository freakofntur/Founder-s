+import androidx.core.graphics.toPoint
+import androidx.core.view.ViewCompat
+import androidx.core.view.WindowInsetsCompat
+import androidx.navigation.NavController
+import kotlin.math.abs
+import kotlin.math.atan2
+import kotlin.math.hypot
+import mozilla.components.browser.state.selector.selectedTab
+import mozilla.components.browser.state.store.BrowserStore
+import mozilla.components.feature.session.SessionUseCases
+import mozilla.components.support.utils.ext.bottom
+import mozilla.components.support.utils.ext.getWindowInsets
+import mozilla.components.support.utils.ext.isKeyboardVisible
+import mozilla.components.support.utils.ext.mandatorySystemGestureInsets
+import mozilla.telemetry.glean.private.NoExtras
+import org.mozilla.fenix.GleanMetrics.Events
+import org.mozilla.fenix.NavGraphDirections
+import org.mozilla.fenix.R
+import org.mozilla.fenix.browser.SwipeGestureListener
+import org.mozilla.fenix.browser.browsingmode.BrowsingMode
+import org.mozilla.fenix.components.AppStore
+import org.mozilla.fenix.components.toolbar.ToolbarPosition
+import org.mozilla.fenix.ext.nav
+import org.mozilla.fenix.tabstray.redux.state.Page
+import mozilla.components.ui.icons.R as iconsR
+
+/**
+ * Foundry's address bar gestures. One handler owns every swipe that starts on the toolbar (or navigation bar) and
+ * decides what it means once the finger has moved far enough to read a direction:
+ *
+ * - **Sideways**: back (finger moves right) or forward (finger moves left), mirrored for right-to-left layouts. The page
+ *   follows the finger and an arrow appears at the edge it is being pulled from.
+ * - **Up** (away from the toolbar's screen edge): the [FoundryTabSwitcher], which shrinks the page into a card that
+ *   follows the finger.
+ *
+ * @param overlayContainer Where the back/forward arrow is drawn.
+ * @param tabSwitcher The card tab switcher, or null to disable the upward gesture.
+ * @param onSwipeStarted Called when a tab-switcher swipe begins, e.g. to capture a thumbnail for the tabs tray.
+ */
+@Suppress("LongParameterList")
+class FoundryToolbarGesturesHandler(
+    private val activity: Activity,
+    private val contentLayout: View,
+    private val overlayContainer: ViewGroup,
+    private val toolbarLayoutRect: () -> Rect?,
+    private val navBarLayoutRect: () -> Rect?,
+    private val toolbarPosition: ToolbarPosition,
+    private val store: BrowserStore,
+    private val sessionUseCases: SessionUseCases,
+    private val tabSwitcher: FoundryTabSwitcher?,
+    private val onSwipeStarted: () -> Unit = {},
+) : SwipeGestureListener {
+
+    private enum class Mode { UNDECIDED, BACK_FORWARD, TAB_SWITCHER, IGNORED }
+
+    private val density = activity.resources.displayMetrics.density
+    private val touchSlop = ViewConfiguration.get(activity).scaledTouchSlop
+    private val minimumFlingVelocity = ViewConfiguration.get(activity).scaledMinimumFlingVelocity
+    private val windowWidth: Int
+        get() = activity.resources.displayMetrics.widthPixels
+    private val isLtr: Boolean
+        get() = activity.resources.configuration.layoutDirection == View.LAYOUT_DIRECTION_LTR
+
+    private var mode = Mode.UNDECIDED
+    private var dx = 0f
+    private var dy = 0f
+    private var startedInSystemGestureInset = false
+    private var arrow: ImageView? = null
+
+    override fun onSwipeStarted(start: PointF, next: PointF): Boolean {
+        if (activity.window.decorView.isKeyboardVisible() || !start.isInBars()) {
+            return false
+        }
+        mode = Mode.UNDECIDED
+        dx = next.x - start.x
+        dy = next.y - start.y
+        startedInSystemGestureInset = start.isInSystemGestureInset()
+        classifyWhenReady()
+        return true
+    }
+
+    override fun onSwipeUpdate(distanceX: Float, distanceY: Float) {
+        dx -= distanceX
+        dy -= distanceY
+        classifyWhenReady()
+
+        when (mode) {
+            Mode.BACK_FORWARD -> updateBackForward()
+            Mode.TAB_SWITCHER -> tabSwitcher?.update(dx, awayFromEdge())
+            else -> Unit
+        }
+    }
+
+    override fun onSwipeFinished(velocityX: Float, velocityY: Float) {
+        when (mode) {
+            Mode.BACK_FORWARD -> finishBackForward(velocityX)
+            Mode.TAB_SWITCHER -> tabSwitcher?.finish(velocityX)
+            else -> Unit
+        }
+        mode = Mode.UNDECIDED
+    }
+
+    private fun classifyWhenReady() {
+        if (mode != Mode.UNDECIDED || hypot(dx, dy) < touchSlop * DECIDE_DISTANCE_SLOPS) return
+
+        // 0° is sideways, 90° is straight away from the toolbar, negative is toward the screen edge.
+        val angle = Math.toDegrees(atan2(awayFromEdge(), abs(dx)).toDouble())
+        mode =
+            when {
+                abs(angle) <= SIDEWAYS_MAX_ANGLE -> Mode.BACK_FORWARD
+                angle > SIDEWAYS_MAX_ANGLE && tabSwitcher != null && !startedInSystemGestureInset -> Mode.TAB_SWITCHER
+                else -> Mode.IGNORED
+            }
+
+        if (mode == Mode.TAB_SWITCHER) {
+            onSwipeStarted()
+            tabSwitcher?.start()
+            tabSwitcher?.update(dx, awayFromEdge())
+        }
+    }
+
+    private fun awayFromEdge() = if (toolbarPosition == ToolbarPosition.BOTTOM) -dy else dy
+
+    private fun isGoingBack() = (dx > 0) == isLtr
+
+    private fun canNavigate(): Boolean {
+        val content = store.state.selectedTab?.content ?: return false
+        return if (isGoingBack()) content.canGoBack else content.canGoForward
+    }
+
+    private fun updateBackForward() {
+        val limit = windowWidth * MAX_DRAG_PERCENT
+        val resistance = if (canNavigate()) DRAG_RESISTANCE else DRAG_RESISTANCE_BLOCKED
+        contentLayout.translationX = (dx * resistance).coerceIn(-limit, limit)
+
+        val progress = (abs(dx) / (windowWidth * COMMIT_PERCENT)).coerceIn(0f, 1f)
+        val view = arrow ?: createArrow().also { arrow = it }
+        val fromLeft = dx > 0
+        val size = ARROW_SIZE_DP * density
+        view.setImageResource(if (isGoingBack()) iconsR.drawable.mozac_ic_back_24 else iconsR.drawable.mozac_ic_forward_24)
+        view.translationX =
+            if (fromLeft) {
+                -size + (size + ARROW_MARGIN_DP * density) * progress
+            } else {
+                overlayContainer.width - (ARROW_MARGIN_DP * density + size) * progress
+            }
+        view.alpha = if (canNavigate()) progress else progress * BLOCKED_ARROW_ALPHA
+        val armed = progress >= 1f && canNavigate()
+        view.scaleX = if (armed) ARMED_SCALE else 1f
+        view.scaleY = view.scaleX
+    }
+
+    private fun finishBackForward(velocityX: Float) {
+        val flungSameWay = abs(velocityX) >= minimumFlingVelocity && (velocityX < 0) == (dx < 0)
+        val committed = (abs(dx) >= windowWidth * COMMIT_PERCENT || flungSameWay) && canNavigate()
+
+        if (committed) {
+            val tab = store.state.selectedTab
+            if (tab != null) {
+                if (isGoingBack()) sessionUseCases.goBack(tab.id) else sessionUseCases.goForward(tab.id)
+            }
+            // The page slides the rest of the way out, then the new one comes in from the other side.
+            val out = if (dx > 0) windowWidth * EXIT_PERCENT else -windowWidth * EXIT_PERCENT
+            contentLayout
+                .animate()
+                .translationX(out)
+                .alpha(EXIT_ALPHA)
+                .setDuration(EXIT_DURATION_MS)
+                .withEndAction {
+                    contentLayout.translationX = -out
+                    contentLayout.animate().translationX(0f).alpha(1f).setDuration(ENTER_DURATION_MS).start()
+                }
+                .start()
+            arrow?.animate()?.scaleX(POP_SCALE)?.scaleY(POP_SCALE)?.alpha(0f)?.setDuration(ENTER_DURATION_MS)?.start()
+        } else {
+            contentLayout.animate().translationX(0f).setDuration(SETTLE_DURATION_MS).start()
+            arrow?.animate()?.alpha(0f)?.setDuration(SETTLE_DURATION_MS)?.start()
+        }
+    }
+
+    private fun createArrow(): ImageView {
+        val size = (ARROW_SIZE_DP * density).toInt()
+        val padding = (ARROW_PADDING_DP * density).toInt()
+        return ImageView(activity).apply {
+            background = GradientDrawable().apply {
+                shape = GradientDrawable.OVAL
+                setColor(Color.argb(ARROW_BACKGROUND_ALPHA, 32, 32, 36))
+            }
+            imageTintList = ColorStateList.valueOf(Color.WHITE)
+            setPadding(padding, padding, padding, padding)
+            elevation = ARROW_ELEVATION_DP * density
+            alpha = 0f
+            overlayContainer.addView(this, FrameLayout.LayoutParams(size, size, Gravity.CENTER_VERTICAL or Gravity.START))
+        }
+    }
+
+    private fun PointF.isInBars(): Boolean {
+        val toolbar = toolbarLayoutRect()?.let { Rect(it) }
+        // A bottom toolbar overlaps the system gesture area, so extend the touch area to cover it.
+        if (toolbar != null && toolbarPosition == ToolbarPosition.BOTTOM) {
+            activity.window.decorView.getWindowInsets()?.let { insets ->
+                toolbar.top -= (insets.mandatorySystemGestureInsets().bottom - insets.bottom())
+            }
+        }
+        val point = toPoint()
+        return toolbar?.contains(point) == true || navBarLayoutRect()?.contains(point) == true
+    }
+
+    /**
+     * Whether the swipe started inside the bottom system gesture area, where swiping up means "go home" to Android.
+     * Upward gestures from there are left to the system.
+     */
+    private fun PointF.isInSystemGestureInset(): Boolean {
+        val root = activity.window.decorView
+        val bottomInset =
+            ViewCompat.getRootWindowInsets(root)?.getInsets(WindowInsetsCompat.Type.systemGestures())?.bottom ?: 0
+        if (bottomInset <= 0) return false
+        val screenBottom = IntArray(2).apply { root.getLocationOnScreen(this) }[1] + root.height
+        return y >= screenBottom - bottomInset
+    }
+
+    private companion object {
+        /** How far (in touch slops) the finger must move before the gesture's direction is decided. */
+        const val DECIDE_DISTANCE_SLOPS = 2
+
+        /** Swipes within this many degrees of horizontal are back/forward; steeper upward swipes open the switcher. */
+        const val SIDEWAYS_MAX_ANGLE = 30.0
+
+        /** Fraction of the screen width a sideways swipe must travel to go back/forward (unless flung). */
+        const val COMMIT_PERCENT = 0.22f
+
+        const val DRAG_RESISTANCE = 0.45f
+        const val DRAG_RESISTANCE_BLOCKED = 0.12f
+        const val MAX_DRAG_PERCENT = 0.3f
+        const val EXIT_PERCENT = 0.35f
+        const val EXIT_ALPHA = 0.4f
+        const val EXIT_DURATION_MS = 110L
+        const val ENTER_DURATION_MS = 220L
+        const val SETTLE_DURATION_MS = 200L
+
+        const val ARROW_SIZE_DP = 48f
+        const val ARROW_PADDING_DP = 12f
+        const val ARROW_MARGIN_DP = 12f
+        const val ARROW_ELEVATION_DP = 6f
+        const val ARROW_BACKGROUND_ALPHA = 220
+        const val BLOCKED_ARROW_ALPHA = 0.35f
+        const val ARMED_SCALE = 1.15f
+        const val POP_SCALE = 1.4f
+    }
+}
+
+/** Opens the tabs tray from the browser or home screen. */
+fun NavController.showTabsTrayFromToolbar(appStore: AppStore) {
+    val current = currentDestination?.id
+    // Avoid racing a navigation that is already under way, and leave the search screen alone.
+    if (current != R.id.browserFragment && current != R.id.homeFragment) return
+    if (appStore.state.searchState.isSearchActive) return
+
+    Events.toolbarTabstraySwipe.record(NoExtras())
+    nav(
+        current,
+        NavGraphDirections.actionGlobalTabManagementFragment(
+            page =
+                when (appStore.state.mode) {
+                    BrowsingMode.Normal -> Page.NormalTabs
+                    BrowsingMode.Private -> Page.PrivateTabs
+                }
+        ),
+    )
+}
